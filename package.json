{
  "name": "avos",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous Villa Operating System — Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "deploy": "npm run build:web && wrangler deploy --env production",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply ivos --local",
    "db:migrate:remote": "wrangler d1 migrations apply ivos --remote --env production",
    "db:seed:local": "wrangler d1 execute ivos --local --file=seed/meadows-varkala.sql",
    "db:seed:remote": "wrangler d1 execute ivos --remote --env production --file=seed/meadows-varkala.sql"
  },
  "dependencies": {
    "@cloudflare/vitest-plugin": "^1.4.5",
    "@vitejs/plugin-react": "^5.2.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "postal-mime": "^4.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.2"
  }
}
