{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avos",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/hooks/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ivos", "database_id": "a34a52c8-60bf-4940-9606-8b64512a7cbb", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "avos-files" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },

  // Local development: no Access, a seeded dev user stands in.
  "vars": {
    "APP_ENV": "development",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "DEV_USER_EMAIL": "",
    "INBOX_PROPERTY_ID": "prop_meadows"
  },

  // Production: deploy with `npm run deploy` (= wrangler deploy --env production).
  // ACCESS_TEAM_DOMAIN pins the Zero Trust team whose logins are trusted; ACCESS_AUD (optional) pins one application.
  // HOOK_SECRET is a secret: `npx wrangler secret put HOOK_SECRET --env production`.
  "env": {
    "production": {
      "name": "avos",
      "d1_databases": [
        { "binding": "DB", "database_name": "ivos", "database_id": "a34a52c8-60bf-4940-9606-8b64512a7cbb", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "avos-files" }
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
      "observability": { "enabled": true },
      // Uncomment once the domain is onboarded to Email Routing (step 8): Wrangler then creates the routing rule.
      // "addresses": ["inbox@YOUR-DOMAIN"],
      "routes": [{ "pattern": "avos.shajianandan.com", "custom_domain": true }],
      // Keep the workers.dev address too: the deploy smoke test uses it, and zone security rules never apply there.
      "workers_dev": true,
      "vars": {
        "APP_ENV": "production",
        "ACCESS_TEAM_DOMAIN": "kshetrom.cloudflareaccess.com",
        "ACCESS_AUD": "",
        "DEV_USER_EMAIL": "",
        "INBOX_PROPERTY_ID": "prop_meadows",
        "APP_URL": "https://avos.shajianandan.com",
        "EMAIL_FROM": ""
      }
      // Password-reset emails: onboard a domain to Email Service (Compute → Email Service), then uncomment and set EMAIL_FROM:
      // "send_email": [{ "name": "EMAIL" }],
    }
  }
}
