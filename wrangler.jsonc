{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ivos",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/hooks/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ivos", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "ivos-files" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "APP_ENV": "development",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "DEV_USER_EMAIL": "shaji@meadowsvarkala.example"
  },
  "observability": { "enabled": true }
}
